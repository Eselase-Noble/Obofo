# ─────────────────────────────────────────────────────────────
#  WhatsApp Watchdog Agent — configuration
#  Copy this file to ".env" and fill in your real values.
# ─────────────────────────────────────────────────────────────

# ===== EMAIL ALERTS (Gmail) =====
# 1. Turn on 2-Step Verification on your Google account.
# 2. Create an "App password": https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below (spaces are fine).
EMAIL_ENABLED=true
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Where alerts are sent (usually your own inbox). Comma-separate for multiple.
ALERT_EMAIL_TO=youraddress@gmail.com

# ===== SMS ALERTS (Twilio) =====
# Sign up at https://twilio.com, buy a number, grab the SID + auth token.
SMS_ENABLED=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# The Twilio number that sends the SMS (in +E.164 format).
TWILIO_FROM_NUMBER=+15550001111
# Your personal phone number that receives the SMS alert.
ALERT_SMS_TO=+233241234567

# ===== BEHAVIOUR =====
# Path to your watchlist file (defaults to ./watchlist.json).
WATCHLIST_PATH=./watchlist.json
# Include a preview of the message text in the alert (true/false).
INCLUDE_MESSAGE_PREVIEW=true
# Max characters of message text to include in the preview.
PREVIEW_MAX_CHARS=200
# Suppress duplicate alerts for the same sender within this many seconds.
DEDUPE_WINDOW_SECONDS=15
