# ─────────────────────────────────────────────────────────────
#  Ɔbɔfo — configuration
#  Copy this file to ".env" and fill in your real values.
# ─────────────────────────────────────────────────────────────

# ===== EMAIL ALERTS (Gmail) =====
# 1. Turn on 2-Step Verification on your Google account.
# 2. Create an "App password": https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below (spaces are fine).
EMAIL_ENABLED=true
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Where alerts are sent (usually your own inbox). Comma-separate for multiple.
ALERT_EMAIL_TO=youraddress@gmail.com

# ===== SMS ALERTS (Arkesel) =====
# 1. Create an account at https://arkesel.com and top up SMS credit.
# 2. Copy your API key from Dashboard → Settings → API Keys.
# 3. Register/approve a Sender ID (max 11 characters) under SMS → Sender IDs.
SMS_ENABLED=true
ARKESEL_API_KEY=your_arkesel_api_key
ARKESEL_SENDER_ID=Obofo
# Your personal phone number(s) that receive the SMS alert (international form).
# + / spaces / dashes are ignored, so "+233 24 123 4567" works. Comma-separate for multiple.
ALERT_SMS_TO=+233241234567

# ===== DEVICE LINKING =====
# How to pair this device with your WhatsApp (only used until it's linked once):
#   qr   = print a QR code in the terminal to scan (rotates every ~20s)
#   code = request an 8-char code to type under
#          WhatsApp → Link a Device → "Link with phone number instead"
LINK_METHOD=qr
# Required when LINK_METHOD=code: the account being linked, full international
# digits with no "+", e.g. 233553851758 for 0553851758.
PAIRING_NUMBER=

# ===== BEHAVIOUR =====
# Path to your watchlist file (defaults to ./watchlist.json).
WATCHLIST_PATH=./watchlist.json
# Include a preview of the message text in the alert (true/false).
INCLUDE_MESSAGE_PREVIEW=true
# Max characters of message text to include in the preview.
PREVIEW_MAX_CHARS=200
# Suppress duplicate alerts for the same sender within this many seconds.
DEDUPE_WINDOW_SECONDS=15
