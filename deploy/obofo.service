# systemd unit for running Ɔbɔfo 24/7 on a Raspberry Pi or Linux VPS.
#
# Install:
#   1. Edit the paths / user below to match your machine.
#   2. sudo cp deploy/obofo.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now obofo
#
# First run only: watch the logs to scan the QR code —
#   journalctl -u obofo -f

[Unit]
Description=Obofo — WhatsApp message/call alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/obofo
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
# Give the QR/reconnect logs somewhere useful to land.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
