// Ɔbɔfo multi-tenant schema
// Each user links their own WhatsApp (WaSession) and configures which contacts
// trigger alerts (WatchlistEntry) and where those alerts go (AlertChannel).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  name         String?
  /// "user" | "admin". The first account to register is promoted to admin.
  role         String           @default("user")
  /// A disabled account can't sign in and its WhatsApp session is stopped.
  active       Boolean          @default(true)
  /// When true, matched events are ignored — alerts stop without unlinking.
  alertsPaused Boolean          @default(false)
  createdAt    DateTime         @default(now())

  session   WaSession?
  watchlist WatchlistEntry[]
  channels  AlertChannel[]
  alerts    AlertLog[]
}

/// One WhatsApp companion session per user. Holds link state + Baileys credentials.
model WaSession {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The account being linked (full international digits, e.g. 233553851758).
  phoneNumber String?
  /// disconnected | linking | connected | logged_out
  status      String  @default("disconnected")
  /// How the user wants to link: "qr" or "code".
  linkMethod  String  @default("qr")
  /// Current QR payload (qr mode) or pairing code (code mode), surfaced to the UI.
  qr          String?
  pairingCode String?
  /// UI sets this to ask the worker to (re)start linking; worker clears it.
  linkRequested Boolean @default(false)

  /// Baileys auth material (serialized with BufferJSON). creds = identity; keys = signal store.
  creds Json?
  keys  Json?

  /// Last time the socket actually reached "connected". Drives the 14-day
  /// linked-device expiry warning (WhatsApp unlinks a device after ~14 days
  /// with the phone offline).
  lastConnectedAt DateTime?

  updatedAt DateTime @updatedAt
}

/// A contact/group whose messages or calls should alert this user.
model WatchlistEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "number" | "group_name" | "group_jid"
  type  String
  /// normalized phone digits, lower-cased group subject, or a …@g.us JID
  value String
  label String?

  createdAt DateTime @default(now())

  @@unique([userId, type, value])
}

/// A privacy-preserving record that an alert fired. Deliberately stores no
/// message content — only who it concerned, whether it was a message or call,
/// and how many channels it reached. Powers the user's recent-activity feed.
model AlertLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "message" | "call"
  kind String
  /// Display name of the matched contact/group (e.g. "Mum", or a masked number).
  who  String
  /// Number of destinations the alert was delivered to.
  channels Int @default(0)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Where a user's alerts are delivered.
model AlertChannel {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "email" | "sms"
  type        String
  /// email address or phone number
  destination String
  enabled     Boolean @default(true)

  createdAt DateTime @default(now())
}
